# Local development only. Never commit real secrets.
APP_URL=http://localhost:3000

# Appwrite (auth + database). API key is server-only.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# Cloudflare R2 (private bucket, S3-compatible). Server-only.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# BYOK encryption keyring: "activeId:base64key32[,olderId:base64key32...]".
# Generate a key: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Rotate: put the new key FIRST, keep old keys until all values are re-encrypted.
CREDENTIAL_ENCRYPTION_KEYS=

# Browser-visible Appwrite settings (public by design, NOT secrets).
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Hard per-job spend ceiling in USD (default 1). Paid jobs above it are refused.
MAX_JOB_COST_USD=1

# Who may use the app. The Appwrite project's users may include other apps' users, so signing in is not
# enough: list your account email(s) and/or Appwrite user id(s), comma-separated. With neither set, everyone is denied.
ALLOWED_USER_EMAILS=
ALLOWED_USER_IDS=
