# Local development only. Never commit real secrets.
APP_URL=http://localhost:3000

# Appwrite (auth + database). API key is server-only.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# Cloudflare R2 (private bucket, S3-compatible). Server-only.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# BYOK encryption keyring: "activeId:base64key32[,olderId:base64key32...]".
# Generate a key: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Rotate: put the new key FIRST, keep old keys until all values are re-encrypted.
CREDENTIAL_ENCRYPTION_KEYS=
